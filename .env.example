# Copy this file to .env and edit. Every setting is optional.

# Vision-language model served by vLLM on the GB10 (OpenAI-compatible).
# On the GB10 itself this is usually http://localhost:8000/v1
HIGHGROUND_VLM_BASE_URL=http://localhost:8000/v1
HIGHGROUND_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
HIGHGROUND_VLM_API_KEY=NONE
# Set to false to always use the built-in template summary.
HIGHGROUND_VLM_ENABLED=true

# Live National Weather Service alerts and USGS river levels.
HIGHGROUND_LIVE_DATA_ENABLED=true
# NWS asks every app to identify itself with a contact address.
HIGHGROUND_CONTACT_EMAIL=team@example.org

# Folder with the real flood images (after `git lfs pull` in the dataset repo).
# Leave blank to link to NOAA's viewer instead.
HIGHGROUND_IMAGES_DIR=

# How far (km) from a dropped pin we will look for an assessed location.
HIGHGROUND_MAX_SNAP_KM=1.0
